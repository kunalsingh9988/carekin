// CareKin — Core Prisma schema (Phase 1 / MVP)
// See CareKin Master Build Prompt, Section 6, for the entity spec this implements.
// Deliberately not over-normalized — expand fields as real flows demand them.

generator client {
  provider        = "prisma-client-js"
  output          = "../../apps/api/src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ---------- Enums ----------

enum UserRole {
  FAMILY
  PROVIDER
  ADMIN
}

enum CareRecipientType {
  ELDER
  CHILD
}

enum ProviderType {
  CAREGIVER
  BABYSITTER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  CERTIFICATE
}

enum BookingType {
  ONE_OFF
  SUBSCRIPTION
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum SubscriptionFrequency {
  WEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  QUEUED
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
  BOOKING_CONFIRMED
  PROVIDER_ASSIGNED
  VISIT_REMINDER
  PAYMENT_RECEIPT
  VERIFICATION_UPDATE
  PAYOUT_UPDATE
}

// ---------- Core identity ----------

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  familyProfile   FamilyProfile?
  providerProfile ProviderProfile?

  sentMessages  Message[]
  notifications Notification[]
  reviewedVerifications VerificationRecord[] @relation("AdminReviewer")

  @@map("users")
}

model FamilyProfile {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  address String

  // Simple lat/lng for display + fallback filtering.
  latitude  Float
  longitude Float
  // PostGIS geography column, backfilled via trigger/raw SQL migration and used
  // for ST_DWithin proximity queries. Prisma can't type geography columns, hence
  // Unsupported — query it with $queryRaw in the search/matching service.
  location Unsupported("geography(Point, 4326)")?

  careRecipients CareRecipient[]
  bookings       Booking[]
  subscriptions  Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
  @@map("family_profiles")
}

model CareRecipient {
  id       String            @id @default(cuid())
  familyId String
  family   FamilyProfile     @relation(fields: [familyId], references: [id], onDelete: Cascade)

  type  CareRecipientType
  name  String
  // Free-text notes only — no structured medical/health data in Phase 1.
  // See Section 11 guardrails: any medical logging needs its own legal/privacy review.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("care_recipients")
}

model ProviderProfile {
  id     String       @id @default(cuid())
  userId String       @unique
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            ProviderType
  bio             String?
  serviceRadiusKm Float        @default(5)

  latitude  Float
  longitude Float
  location  Unsupported("geography(Point, 4326)")?

  verificationRecord VerificationRecord?
  documents          Document[]
  bookings           Booking[]
  subscriptions      Subscription[]
  payouts            Payout[]
  reviews            Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
  @@map("provider_profiles")
}

// ---------- Trust & safety ----------

model VerificationRecord {
  id         String             @id @default(cuid())
  providerId String             @unique
  provider   ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  status VerificationStatus @default(PENDING)

  kycProviderRef        String?
  policeVerificationRef String?

  // A human admin must always countersign, even after vendor checks pass.
  reviewedByAdminId String?
  reviewedByAdmin   User?    @relation("AdminReviewer", fields: [reviewedByAdminId], references: [id])
  reviewedAt        DateTime?
  notes             String?

  auditLogs VerificationAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("verification_records")
}

// Every status change must be attributable — who, when, why (Section 7).
model VerificationAuditLog {
  id                   String             @id @default(cuid())
  verificationRecordId String
  verificationRecord   VerificationRecord @relation(fields: [verificationRecordId], references: [id], onDelete: Cascade)

  fromStatus VerificationStatus?
  toStatus   VerificationStatus
  changedBy  String
  reason     String?
  createdAt  DateTime @default(now())

  @@map("verification_audit_logs")
}

model Document {
  id         String          @id @default(cuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  type       DocumentType
  // S3/R2 object key only — never a public URL. Access is brokered by role
  // through the API (signed URLs), never fetched directly by families.
  s3Key      String
  uploadedAt DateTime @default(now())

  @@map("documents")
}

// ---------- Bookings, payments, payouts ----------

model Booking {
  id         String          @id @default(cuid())
  familyId   String
  family     FamilyProfile   @relation(fields: [familyId], references: [id])
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])

  type            BookingType
  status          BookingStatus @default(REQUESTED)
  scheduledAt     DateTime
  durationHours   Float
  amount          Decimal       @db.Decimal(10, 2)
  commissionAmount Decimal      @db.Decimal(10, 2)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  payment  Payment?
  payout   Payout?
  review   Review?
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@index([providerId])
  @@index([status])
  @@map("bookings")
}

model Subscription {
  id         String          @id @default(cuid())
  familyId   String
  family     FamilyProfile   @relation(fields: [familyId], references: [id])
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])

  frequency      SubscriptionFrequency
  amount         Decimal               @db.Decimal(10, 2)
  nextBillingDate DateTime
  status         SubscriptionStatus    @default(ACTIVE)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id])

  razorpayOrderId String       @unique
  status          PaymentStatus @default(CREATED)
  amount          Decimal       @db.Decimal(10, 2)
  capturedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model Payout {
  id         String          @id @default(cuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])
  bookingId  String          @unique
  booking    Booking         @relation(fields: [bookingId], references: [id])

  amount           Decimal      @db.Decimal(10, 2)
  status           PayoutStatus @default(QUEUED)
  payoutProviderRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@map("payouts")
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])

  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  @@map("reviews")
}

// ---------- Chat & notifications ----------

model Message {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])
  content  String

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("messages")
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  payload Json
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}
