# Copy apps/web/.env.example to apps/web/.env.local for the cloud development backend.
# The application uses user-scoped Supabase access and needs no privileged key.
NEXT_PUBLIC_BACKEND_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set NEXT_PUBLIC_BACKEND_MODE=demo only for the isolated localStorage prototype.
