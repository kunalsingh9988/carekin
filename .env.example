# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database / cache (local dev via infra/docker-compose.yml) ---
DATABASE_URL="postgresql://carekin:carekin@localhost:5432/carekin"
REDIS_URL="redis://localhost:6379"

# --- Auth (phone OTP) ---
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# or: TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# --- Payments ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- KYC / background checks ---
# KYC_VENDOR_API_KEY=
# KYC_VENDOR_WEBHOOK_SECRET=

# --- File storage ---
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# or Cloudflare R2 equivalents

# --- Push notifications ---
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# --- Observability ---
# SENTRY_DSN=

JWT_SECRET="dev-only-change-me"
NODE_ENV="development"
PORT=4000
