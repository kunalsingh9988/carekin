{
  "name": "carekin",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:start": "supabase start --workdir packages/supabase",
    "db:stop": "supabase stop --workdir packages/supabase",
    "db:reset": "supabase db reset --workdir packages/supabase",
    "db:types": "supabase gen types typescript --local --workdir packages/supabase > packages/types/src/supabase.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
