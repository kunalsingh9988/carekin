{
  "meta": {
    "note": "Urban Company brand guidelines v1.0 — calm monochrome surfaces, one confident violet, rating green reserved for ratings/success/verified. Values below are verbatim from the brand book (source: \"uc-brand\"). Dark scheme has no brand-book spec; values are derived inversions marked \"derived\". Typography pairing B: Bricolage Grotesque display (>=28px only) / Figtree body / Noto Sans Devanagari for Hindi."
  },
  "color": {
    "light": {
      "bgCanvas": { "value": "#FFFFFF", "source": "uc-brand", "usage": "Paper — page ground, 55% of every screen" },
      "surface": { "value": "#FFFFFF", "source": "uc-brand", "usage": "Paper — card ground" },
      "surfaceSecondary": { "value": "#F4F4F5", "source": "uc-brand", "usage": "Mist — section bands, image wells, chips (20%)" },
      "border": { "value": "#E4E4E7", "source": "uc-brand", "usage": "Line — borders, dividers" },
      "textPrimary": { "value": "#0F0F0F", "source": "uc-brand", "usage": "Ink — headings, primary text, hero surfaces (15%)" },
      "ink": { "value": "#0F0F0F", "source": "uc-brand", "usage": "Ink as a SURFACE — hero bands. Fixed brand surface: stays dark in both color schemes." },
      "textSecondary": { "value": "#6B6B72", "source": "uc-brand", "usage": "Slate — secondary text, struck prices. Never below 14px." },
      "accent": { "value": "#6E42E5", "source": "uc-brand", "usage": "Violet — THE action color: CTAs, links, focus, selection. One violet action per view (8%)." },
      "accentText": { "value": "#4F2BB8", "source": "uc-brand", "usage": "Violet deep — hover/pressed, accent-colored text" },
      "accentTint": { "value": "#EFE9FF", "source": "uc-brand", "usage": "Violet tint — selected states, promo strips" },
      "verified": { "value": "#14804A", "source": "uc-brand", "usage": "Rating green — RESERVED: ratings, speed claims, success, verified. Never decoration." },
      "highlight": { "value": "#EFE9FF", "source": "uc-brand", "usage": "Decorative slot — Violet tint" },
      "danger": { "value": "#C62828", "source": "uc-brand", "usage": "Alert red — errors only, never promos or discounts" },
      "warning": { "value": "#6B6B72", "source": "uc-brand", "usage": "Pending/attention-neutral — UC has no amber; pending states read as Slate" },
      "successGeneric": { "value": "#14804A", "source": "uc-brand", "usage": "Rating green — success IS green in this system (booking confirmed, paid)" }
    },
    "dark": {
      "bgCanvas": { "value": "#0F0F0F", "source": "derived" },
      "surface": { "value": "#1A1A1E", "source": "derived" },
      "surfaceSecondary": { "value": "#26262B", "source": "derived" },
      "border": { "value": "#333338", "source": "derived" },
      "textPrimary": { "value": "#F4F4F5", "source": "derived" },
      "ink": { "value": "#0F0F0F", "source": "derived", "usage": "Brand Ink surface — intentionally NOT inverted" },
      "textSecondary": { "value": "#A1A1AA", "source": "derived" },
      "accent": { "value": "#6E42E5", "source": "derived", "usage": "Fill stays brand violet — white label on it still passes" },
      "accentText": { "value": "#A98FF5", "source": "derived", "usage": "Lightened violet for accent-colored text on dark" },
      "accentTint": { "value": "#2E2350", "source": "derived" },
      "verified": { "value": "#3BA469", "source": "derived" },
      "highlight": { "value": "#2E2350", "source": "derived" },
